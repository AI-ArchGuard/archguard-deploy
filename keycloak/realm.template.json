{
  "realm": "archguard",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [{
    "clientId": "archguard-web",
    "name": "ArchGuard Web",
    "enabled": true,
    "publicClient": true,
    "standardFlowEnabled": true,
    "directAccessGrantsEnabled": false,
    "redirectUris": ["http://localhost:8080/auth/callback"],
    "webOrigins": ["http://localhost:8080"],
    "defaultClientScopes": ["web-origins", "profile", "roles", "email", "project:create"],
    "protocolMappers": [{
      "name": "archguard-platform-audience",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "consentRequired": false,
      "config": {
        "included.client.audience": "archguard-platform",
        "id.token.claim": "false",
        "access.token.claim": "true"
      }
    }, {
      "name": "subject",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-sub-mapper",
      "consentRequired": false,
      "config": {
        "id.token.claim": "true",
        "access.token.claim": "true"
      }
    }]
  }, {
    "clientId": "archguard-platform",
    "name": "ArchGuard Platform",
    "enabled": true,
    "bearerOnly": true
  }],
  "clientScopes": [{
    "name": "project:create",
    "protocol": "openid-connect",
    "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "false"}
  }],
  "users": [{
    "id": "11111111-1111-4111-8111-111111111111",
    "username": "maintainer",
    "email": "maintainer@localhost.invalid",
    "firstName": "Local",
    "lastName": "Maintainer",
    "enabled": true,
    "emailVerified": true,
    "requiredActions": [],
    "credentials": [{"type": "password", "value": "__DEMO_USER_PASSWORD__", "temporary": false}]
  }]
}
